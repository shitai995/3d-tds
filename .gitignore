sysinfo.txt

# 临时备份文件
Assets/**/*~
Assets/**/*.bak

# 打包输出产物
*.apk
*.unitypackage
*.exe
*.zip
Build/Windows/
Build/Windows64/

# 系统隐藏垃圾文件
.DS_Store
Thumbs.db
